{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "echo foreign-stop",
        "timeout": 5
      },
      {
        "command": ".cursor\\hooks\\proteus_hook.cmd --hook-event stop",
        "timeout": 15,
        "loop_limit": 2
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor\\hooks\\proteus_hook.cmd --hook-event sessionStart",
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "command": ".cursor\\hooks\\proteus_hook.cmd --hook-event preCompact",
        "timeout": 15
      }
    ]
  }
}
